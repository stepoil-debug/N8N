{
  email {$ACME_EMAIL:off}
  admin off
}

{$N8N_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy n8n-main:5678 {
    health_uri /healthz
    health_interval 30s
    health_timeout 5s
  }

  log {
    output stdout
    format json
  }
}
