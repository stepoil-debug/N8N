# Images — replace with versions approved and tested by STEP
N8N_VERSION=REPLACE_WITH_APPROVED_VERSION
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine

# Public endpoint
N8N_DOMAIN=n8n.example.com
N8N_PROTOCOL=https
GENERIC_TIMEZONE=America/Sao_Paulo

# n8n encryption and authentication
# Generate at least 32 random bytes. All n8n processes must use the same key.
N8N_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Internal n8n database
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
N8N_DB_POOL_SIZE=10

# Queue
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
N8N_WORKER_CONCURRENCY=5

# Execution retention
EXECUTIONS_DATA_MAX_AGE_HOURS=336

# Audit API
AUDIT_API_LOG_LEVEL=INFO
AUDIT_API_WORKERS=2
AUDIT_API_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Supabase domain storage — use service credentials only inside backend services
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET
SUPABASE_PRIVATE_BUCKET=audit-private

# Model adapter
MODEL_PROVIDER=REPLACE_WITH_PROVIDER
MODEL_BASE_URL=
MODEL_API_KEY=REPLACE_WITH_SECRET
MODEL_NAME=REPLACE_WITH_APPROVED_MODEL

# Optional OCR adapter
OCR_PROVIDER=disabled
OCR_ENDPOINT=
OCR_API_KEY=
